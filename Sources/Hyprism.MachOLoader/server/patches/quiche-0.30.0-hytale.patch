+    /// Hytale extension: configures a DER-encoded certificate from memory.
+    pub fn load_cert_from_der(&mut self, der: &[u8]) -> Result<()> {
+        self.tls_ctx.use_certificate_der(der)
+    }
+
+    /// Hytale extension: configures a DER-encoded private key from memory.
+    pub fn load_priv_key_from_der(&mut self, der: &[u8]) -> Result<()> {
+        self.tls_ctx.use_privkey_der(der)
+    }
+
+    /// Hytale extension: requests the peer certificate but accepts any.
+    pub fn verify_peer_optional(&mut self) {
+        self.tls_ctx.set_verify_optional();
+    }
+
     pub fn verify_peer(&mut self, verify: bool) {
         self.tls_ctx.set_verify(verify);
     }
