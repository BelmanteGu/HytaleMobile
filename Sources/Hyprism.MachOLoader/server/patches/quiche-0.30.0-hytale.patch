+    /// Hytale extension: uses a DER-encoded certificate held in memory.
+    pub fn use_certificate_der(&mut self, der: &[u8]) -> Result<()> {
+        map_result(unsafe {
+            SSL_CTX_use_certificate_ASN1(self.as_mut_ptr(), der.len(), der.as_ptr())
+        })
+    }
+
+    /// Hytale extension: uses a DER-encoded (PKCS#8 or traditional) private
+    /// key held in memory.
+    pub fn use_privkey_der(&mut self, der: &[u8]) -> Result<()> {
+        unsafe {
+            let mut p = der.as_ptr();
+            let key = d2i_AutoPrivateKey(ptr::null_mut(), &mut p, der.len() as c_long);
+            if key.is_null() {
+                return Err(Error::TlsFail);
+            }
+            let rc = SSL_CTX_use_PrivateKey(self.as_mut_ptr(), key);
+            EVP_PKEY_free(key);
+            map_result(rc)
+        }
+    }
+
+    /// Hytale extension: requests a peer certificate without making
+    /// verification fatal. The application checks the certificate itself
+    /// through `peer_cert()`.
+    pub fn set_verify_optional(&mut self) {
+        unsafe {
+            SSL_CTX_set_custom_verify(self.as_mut_ptr(), 0x01, Some(accept_any_peer));
+        }
+    }
